# Telegram bot sozlamalari (ushbu fayldan nusxa olib .env nomli fayl yarating)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rasmiy Ozon Seller API kalitlari (Ozon Seller kabineti -> Настройки -> API ключи)
OZON_CLIENT_ID=
OZON_API_KEY=

# Rasmiy Uzum Market Seller OpenAPI kaliti (Uzum Seller kabineti -> API Keys)
# UZUM_SHOP_ID ixtiyoriy: bo'sh qoldirilsa API kalitga tegishli barcha do'konlar avtomatik olinadi
UZUM_API_KEY=
UZUM_SHOP_ID=

# Ixtiyoriy: Telegram API uchun proksi (masalan: http://127.0.0.1:10809)
TELEGRAM_PROXY=

# Ixtiyoriy: Playwright parser / Seller API uchun proksi (bo'sh qoldirilsa to'g'ridan-to'g'ri ishlaydi)
PROXY_URL=

# Vaqt mintaqasi (masalan: Asia/Tashkent yoki Europe/Moscow)
TIMEZONE=Asia/Tashkent

# Ma'lumotlar bazasi yo'li (Docker / Railway Volume uchun: /data/marketpulse.db)
DB_PATH=marketpulse.db

# Ixtiyoriy zaxira: n8n Webhook orqali yuborish (to'ldirilsa Telegram o'rniga shu ishlaydi)
N8N_WEBHOOK_URL=
N8N_API_KEY=
